  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\nIf no room code, it defaults to an open lobby.\n\nControls:\n- Movement\n\t-
    Joystick\n\t- Teleport  :  Trigger/OK button when looking at ground\n- Interaction\n\t-
    Pick up and drop object  :  X button\n\t- Use object  :  Trigger/ OK button whle
    holding object\n- Pause Menu  :  B button\n\nHow to play:\n1. Pick up seed bag
    and use it on soil bed to plant seed\n2. Pick up watering can and use on well
    to fill it up, use on seed dye bags to select color of flower\n3. Use filled
    watering can on soil bed with planted seeds to grow flower\n4. Pick up pot and
    use on flower to put flower in pot\n5. Give pot with flower to NPC\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
